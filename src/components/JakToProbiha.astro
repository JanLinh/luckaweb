---
import { Image } from 'astro:assets';
import detail1 from '../assets/images/detail-1.jpg';

const kroky = [
  {
    ikona: '📅',
    titulek: 'Nezávazně si zarezervujte 1. sezení zdarma.',
    text: 'Bez závazků, jen kliknete a vyberete termín.',
  },
  {
    ikona: '🤝',
    titulek: 'Poznáme se.',
    text: 'Na prvním setkání v klidu probereme, co vás trápí a co chcete řešit.',
  },
  {
    ikona: '🌱',
    titulek: 'Vydáme se na cestu.',
    text: 'Společně vytvoříme jasný plán a začnete se posouvat.',
  },
];
---

<section class="bg-podklad px-4 py-16 md:px-8 md:py-24">
  <div class="mx-auto max-w-3xl text-center">
    <h2 class="text-3xl md:text-4xl">Stačí jeden malý krok</h2>
  </div>

  <div class="mx-auto mt-10 grid max-w-5xl gap-6 md:grid-cols-3">
    {kroky.map((k, i) => (
      <div class="rounded-2xl bg-karta p-7 text-center">
        <span class="text-4xl" aria-hidden="true">{k.ikona}</span>
        <p class="mt-3 section-eyebrow">Krok {i + 1}</p>
        <h3 class="mt-2 text-xl text-primarni-tmava md:text-2xl">{k.titulek}</h3>
        <p class="mt-3 text-base font-medium text-text md:text-lg">{k.text}</p>
      </div>
    ))}
  </div>

  <p class="mx-auto mt-8 max-w-xl text-center text-sm text-text-svetla">
    Osobně v Praze a Středočeském kraji, nebo online přes Zoom odkudkoliv.
  </p>

  <Image
    src={detail1}
    alt="Klidové zátiší s čajem, zápisníkem a eukalyptem u okna"
    widths={[400, 600, 800]}
    sizes="(min-width: 768px) 500px, 80vw"
    format="webp"
    quality={80}
    loading="lazy"
    class="mx-auto mt-10 h-auto w-full max-w-md rounded-2xl object-contain shadow-md"
  />
</section>
