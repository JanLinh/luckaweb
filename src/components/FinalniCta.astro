---
import { CALENDLY_URL, EMAIL } from '../config';
---

<section id="kontakt" class="bg-primarni-tmava px-4 py-16 text-white md:px-8 md:py-24">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-3xl text-white md:text-4xl">Udělejte ten první krok pro sebe ještě dnes</h2>
    <p class="mt-4 text-base text-white/85 md:text-lg">
      Nebuďte na to sami. Vyberte si termín úvodního sezení, zdarma a nezávazně.
    </p>
  </div>

  {CALENDLY_URL && (
    <div class="mx-auto mt-10 max-w-xl overflow-hidden rounded-2xl bg-podklad shadow-lg">
      <div
        class="calendly-inline-widget"
        data-url={`${CALENDLY_URL}?primary_color=74be90`}
        style="min-width:320px;height:700px;"
      >
      </div>
    </div>
  )}

  <p class="mx-auto mt-8 max-w-xl text-center text-sm text-white/85">
    Nevybrali jste si žádný termín? Napište mi na
    {' '}
    <a href={`mailto:${EMAIL}`} class="font-semibold underline decoration-white/50 underline-offset-2 hover:decoration-white">{EMAIL}</a>.
  </p>
</section>

{CALENDLY_URL && <script type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async is:inline></script>}

<script is:inline>
  // Meta Pixel Lead event po úspěšné rezervaci přes Calendly
  window.addEventListener('message', function (e) {
    if (e.data && e.data.event === 'calendly.event_scheduled') {
      if (window.fbq) window.fbq('track', 'Lead');
    }
  });
</script>
