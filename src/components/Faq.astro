---
const balicky = [
  {
    nazev: 'Jednotlivé sezení',
    pocet: '90 minut',
    cena: '1 900 Kč',
    poznamka: '',
    popis: 'Vhodné pro jednorázovou konzultaci nebo doladění konkrétního tématu.',
    doporuceno: false,
  },
  {
    nazev: 'Balíček „Restart“',
    pocet: '5 sezení',
    cena: '8 500 Kč',
    poznamka: '1 700 Kč/sezení, ušetříte 1 000 Kč',
    popis: 'Ideální pro vyřešení konkrétní životní křižovatky, úklid v prioritách a nový profesní plán.',
    doporuceno: false,
  },
  {
    nazev: 'Balíček „Proměna“',
    pocet: '10 sezení',
    cena: '15 000 Kč',
    poznamka: '1 500 Kč/sezení, ušetříte 4 000 Kč',
    popis: 'Komplexní cesta k trvalé změně: nastavení pevných hranic, utišení vnitřního kritika a návrat k plné energii i sebevědomí.',
    doporuceno: true,
  },
];

const otazky = [
  {
    q: 'Je koučink to samé co terapie?',
    a: 'Ne. Terapie se často vrací do minulosti a hojí staré rány. Transformační koučink stojí v přítomnosti a dívá se dopředu: kde jste teď, kam chcete dojít a co pro to můžete udělat? Zaměřujeme se na vaše vnitřní zdroje, odstranění mentálních bloků a konkrétní činy.',
  },
  {
    q: 'Pro koho je koučink vhodný?',
    a: 'Především pro rodiče, kteří se cítí vyčerpaní, pod neustálým tlakem nebo mají pocit, že po cestě ztratili sami sebe. Pomohu vám, ať už řešíte návrat do práce, nastavení hranic, vztahy, nebo stojíte na důležité životní křižovatce a hledáte nový směr.',
  },
  {
    q: 'Je první sezení opravdu nezávazné?',
    a: 'Ano, na 100 %. Slouží k tomu, abychom se v klidu seznámili, pojmenovali vaši situaci a zjistili, zda si lidsky sedneme. K ničemu dalšímu vás nezavazuje, rozhodnutí, zda budeme pokračovat, je čistě na vás.',
  },
  {
    q: 'Kolik sezení budu potřebovat?',
    a: 'Je to velmi individuální a záleží na hloubce tématu. Pro vyřešení konkrétního rozhodnutí či rychlý kariérní restart často stačí 5 sezení (Restart). Pro trvalejší změnu návyků, práci se sebedůvěrou a vnitřním kritikem je ideální série 10 setkání (Proměna). Vše si ujasníme na úvodní konzultaci.',
  },
  {
    q: 'Jak koučink probíhá?',
    a: 'Můžeme se potkat online z pohodlí vašeho domova (nemusíte řešit dopravu ani hlídání dětí), anebo osobně v Praze a okolí.',
  },
  {
    q: 'Kolik to stojí?',
    a: 'Úvodní 30minutové sezení je vždy zdarma. Koučink přináší největší výsledky v pravidelné sérii, proto nabízím zvýhodněné balíčky. Společně vybereme na prvním setkání, která varianta pro vás dává největší smysl.',
    balicky: true,
  },
];
---

<section class="bg-karta px-4 py-16 md:px-8 md:py-24">
  <div class="mx-auto max-w-3xl text-center">
    <h2 class="text-3xl md:text-4xl">Časté otázky</h2>
  </div>

  <div class="mx-auto mt-10 max-w-3xl divide-y divide-linka rounded-2xl bg-bila shadow-sm">
    {otazky.map((item) => (
      <details class="group px-6 py-5">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium text-primarni-tmava marker:content-none">
          {item.q}
          <span class="shrink-0 text-xl text-primarni transition-transform group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <p class="prose-p mt-3">{item.a}</p>

        {item.balicky && (
          <div class="mt-5 grid gap-4 sm:grid-cols-3">
            {balicky.map((b) => (
              <div class={`flex flex-col rounded-2xl border p-5 ${b.doporuceno ? 'border-akcent bg-akcent/5' : 'border-linka bg-podklad'}`}>
                {b.doporuceno && (
                  <span class="mb-2 inline-block w-fit rounded-full bg-akcent px-3 py-1 text-xs font-semibold text-white">Doporučeno</span>
                )}
                <p class="font-display text-lg text-primarni-tmava">{b.nazev}</p>
                {b.pocet && <p class="text-sm text-text-svetla">{b.pocet}</p>}
                <p class="mt-2 text-2xl font-semibold text-text">{b.cena}</p>
                {b.poznamka && <p class="mt-1 text-xs text-text-svetla">{b.poznamka}</p>}
                {b.popis && <p class="mt-3 text-sm text-text-svetla">{b.popis}</p>}
              </div>
            ))}
          </div>
        )}
      </details>
    ))}
  </div>
</section>
