---
import { CALENDLY_URL, CTA_HREF } from '../config';
---

<div class="fixed inset-x-0 bottom-0 z-40 border-t border-linka bg-bila/95 p-3 backdrop-blur md:hidden">
  <a
    href={CALENDLY_URL || CTA_HREF}
    target={CALENDLY_URL ? '_blank' : undefined}
    rel={CALENDLY_URL ? 'noopener noreferrer' : undefined}
    class="btn-cta w-full"
  >
    <span aria-hidden="true">☑</span> Rezervovat úvodní sezení zdarma
  </a>
</div>
